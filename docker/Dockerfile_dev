# Development image: source code is bind-mounted at /app and Air watches the
# tree — rebuilding the Go server (templates/ and static/ are re-embedded via
# go:embed) and running the esbuild bundling (CodeMirror + tree-shaken Chart.js)
# via pre_cmd before each Go rebuild. node_modules, the Go module cache and the
# Go build cache live in named volumes outside the mount so platform-specific
# binaries (esbuild) and modules survive the bind mount.
FROM golang:1.27.0-alpine

RUN apk add --no-cache git ca-certificates nodejs npm postgresql18-client

# Air: Go live-reload tool — watches files, runs pre_cmd, rebuilds & restarts.
RUN go install github.com/air-verse/air@latest

ENV CGO_ENABLED=0 \
    PATH="/go/bin:${PATH}"

WORKDIR /app

# Go dependencies — cached in the image at /go/pkg/mod (kept out of the mount).
COPY go.mod go.sum ./
RUN go mod download

# Frontend toolchain — produces /app/node_modules, kept in a named volume so
# the host's win32 node_modules never shadow the linux esbuild binary.
COPY package.json package-lock.json ./
RUN npm install --no-audit --no-fund

EXPOSE 8080

CMD ["air", "-c", "/app/docker/air.toml"]