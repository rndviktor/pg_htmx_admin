# Default credentials for the demo user, seeded into SQLite on startup.
# The password is stored in the database as a PBKDF2 hash, never in plain text.
PGHTMX_ADMIN_DEFAULT_EMAIL=admin@admin.com
PGHTMX_ADMIN_DEFAULT_PASSWORD=secret
# Directory for pg_dump backups / Storage Manager files (default: ./host_files/backups).
# BACKUP_DIR=host_files/backups
# Folder the Save dialog starts in (default: ./host_files/scripts).
# host_files/ is the one folder shared with the host (mounted in Docker).
# SCRIPTS_DIR=host_files/scripts
